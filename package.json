{
  "name": "ct0-web",
  "version": "0.1.0",
  "description": "Browser/Node SDK for CT0 (alias3-micro-1026) ONNX — System 1 (decide), gate, and System 2 (generate) over onnxruntime-web (WebGPU).",
  "type": "module",
  "main": "./dist/ct0.js",
  "module": "./dist/ct0.js",
  "types": "./src/ct0.ts",
  "exports": {
    ".": {
      "types": "./src/ct0.ts",
      "import": "./dist/ct0.js"
    }
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "build": "esbuild src/ct0.ts --format=esm --target=es2022 --outfile=dist/ct0.js"
  },
  "peerDependencies": {
    "@huggingface/transformers": ">=3.0.0",
    "onnxruntime-web": ">=1.20.0"
  },
  "keywords": ["onnx", "transformers.js", "onnxruntime-web", "webgpu", "llm", "ct0", "alias3-micro", "cybersecurity"],
  "repository": { "type": "git", "url": "git+https://github.com/eduardoworrel/ct0-web.git" },
  "homepage": "https://huggingface.co/eduardoworrel/ct0-alias3-micro-onnx",
  "license": "MIT",
  "author": "eduardoworrel"
}
