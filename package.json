{
  "name": "ct0-edge",
  "version": "0.6.0",
  "description": "On-device SDK for CT0 (alias3-micro-1026) in the browser and Node: one CT0.load({ runtime }) over ONNX Runtime GenAI, decode-only ONNX Runtime, transformers.js, WebLLM and (experimental) LiteRT.js; typed System-1 ask() (noul / choice / score) and System-2 generate().",
  "type": "module",
  "main": "./dist/ct0.js",
  "module": "./dist/ct0.js",
  "types": "./dist/types/ct0.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/ct0.d.ts",
      "default": "./dist/ct0.js"
    },
    "./webllm": {
      "types": "./dist/types/webllm.d.ts",
      "default": "./dist/webllm.js"
    },
    "./systemone": {
      "types": "./dist/types/systemone.d.ts",
      "default": "./dist/systemone.js"
    },
    "./headdecide": {
      "types": "./dist/types/headdecide.d.ts",
      "default": "./dist/headdecide.js"
    },
    "./positions": {
      "types": "./dist/types/positions.d.ts",
      "default": "./dist/positions.js"
    },
    "./ask": {
      "types": "./dist/types/ask.d.ts",
      "default": "./dist/ask.js"
    },
    "./decode-only": {
      "types": "./dist/types/backends/decodeOnly.d.ts",
      "default": "./dist/decodeOnly.js"
    },
    "./transformers": {
      "types": "./dist/types/backends/transformersjs.d.ts",
      "default": "./dist/transformers.js"
    },
    "./genai": {
      "types": "./dist/types/backends/genai.d.ts",
      "default": "./dist/genai.js"
    },
    "./litert": {
      "types": "./dist/types/backends/litert.d.ts",
      "default": "./dist/litert.js"
    }
  },
  "files": [
    "dist/ct0.js",
    "dist/webllm.js",
    "dist/systemone.js",
    "dist/headdecide.js",
    "dist/positions.js",
    "dist/ask.js",
    "dist/decodeOnly.js",
    "dist/transformers.js",
    "dist/genai.js",
    "dist/litert.js",
    "dist/types",
    "src/ct0.ts",
    "src/webllm.ts",
    "src/systemone.ts",
    "src/headdecide.ts",
    "src/positions.ts",
    "src/ask.ts",
    "src/backend.ts",
    "src/ortVersion.ts",
    "src/nodeFiles.ts",
    "src/runtime.ts",
    "src/backends/decodeOnly.ts",
    "src/backends/transformersjs.ts",
    "src/backends/genai.ts",
    "src/backends/litert.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/bench/pick-a-model.svg",
    "docs/bench/logos/*"
  ],
  "scripts": {
    "build": "esbuild src/ct0.ts --format=esm --target=es2022 --bundle --packages=external --outfile=dist/ct0.js && esbuild src/backends/decodeOnly.ts --format=esm --target=es2022 --bundle --outfile=dist/decodeOnly.js && esbuild src/webllm.ts --format=esm --target=es2022 --bundle --outfile=dist/webllm.js && esbuild src/systemone.ts --format=esm --target=es2022 --bundle --outfile=dist/systemone.js && esbuild src/headdecide.ts --format=esm --target=es2022 --bundle --outfile=dist/headdecide.js && esbuild src/positions.ts --format=esm --target=es2022 --bundle --outfile=dist/positions.js && esbuild src/ask.ts --format=esm --target=es2022 --bundle --outfile=dist/ask.js && esbuild src/backends/transformersjs.ts --format=esm --target=es2022 --bundle --packages=external --outfile=dist/transformers.js && esbuild src/backends/genai.ts --format=esm --target=es2022 --bundle --packages=external --outfile=dist/genai.js && esbuild src/backends/litert.ts --format=esm --target=es2022 --bundle --outfile=dist/litert.js && npm run build:types",
    "test": "npm run typecheck && npm run test:types:nodenext && for f in test/test_*.mjs; do node \"$f\" || exit 1; done",
    "prepare": "npm run build",
    "test:parity": "node test/parity_decode_only.mjs",
    "test:browser": "node test/browser/smoke_ct0.mjs",
    "test:parity:transformers": "node test/parity_transformers.mjs",
    "test:parity:full": "node test/parity_full.mjs",
    "test:browser:genai": "node test/browser/genai_browser.mjs",
    "test:browser:webllm": "node test/browser/webllm_browser.mjs",
    "build:types": "rm -rf dist/types && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test:types:nodenext": "mkdir -p test/fixtures/nodenext/node_modules && ln -sfn ../../../.. test/fixtures/nodenext/node_modules/ct0-edge && tsc -p test/fixtures/nodenext/tsconfig.json",
    "figures": "node scripts/bench_figures.mjs"
  },
  "peerDependencies": {
    "@huggingface/transformers": ">=3.0.0",
    "onnxruntime-web": ">=1.30.0",
    "onnxruntime-node": ">=1.30.0",
    "@mlc-ai/web-llm": ">=0.2.86",
    "@litertjs/core": "2.6.0"
  },
  "keywords": [
    "onnx",
    "transformers.js",
    "onnxruntime-web",
    "webgpu",
    "llm",
    "ct0",
    "alias3-micro",
    "cybersecurity",
    "onnxruntime-node",
    "onnxruntime-genai",
    "webllm",
    "node"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eduardoworrel/ct0-edge.git"
  },
  "homepage": "https://github.com/eduardoworrel/ct0-edge#readme",
  "license": "MIT",
  "author": "eduardoworrel",
  "devDependencies": {
    "esbuild": "0.28.2",
    "onnxruntime-node": "^1.30.0",
    "typescript": "^5.9.3"
  },
  "peerDependenciesMeta": {
    "onnxruntime-web": {
      "optional": true
    },
    "onnxruntime-node": {
      "optional": true
    },
    "@mlc-ai/web-llm": {
      "optional": true
    },
    "@litertjs/core": {
      "optional": true
    }
  }
}
